# =========================================
# 1. Next.js & Node.js Dependencies
# =========================================
# Do not commit generated folders such as node_modules
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =========================================
# 2. Next.js Build Outputs & Configs
# =========================================
# Do not commit build outputs
.next/
out/
build/
dist/
.vercel/
next-env.d.ts
*.tsbuildinfo
/coverage

# =========================================
# 3. Environment Variables & Secrets
# =========================================
# Never commit passwords, connection secrets, or private MongoDB credentials to GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*
*.pem

# =========================================
# 4. Database Dumps & Logs
# =========================================
# Do not commit database dumps containing credentials
*.dump
*.sql
*.bson
*.json.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =========================================
# 5. IDE Caches & OS Files
# =========================================
# Do not commit IDE caches
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================================
# 6. Python & Data Engineering (Optional Seed Scripts)
# =========================================
# Do not commit virtual environments
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# =========================================
